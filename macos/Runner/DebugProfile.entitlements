<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox is deliberately off.
	     This app is distributed directly rather than through the App Store,
	     and notarisation asks for the hardened runtime, not the sandbox.
	     Sandboxed, it cannot do the things it exists to do: read the private
	     key at ~/.ssh/id_ed25519, or trust a certificate authority sitting in
	     an arbitrary directory.  The sandbox only ever grants access to a file
	     the user picks in the open panel, and only until the app quits - so a
	     saved profile, which holds a path, would be denied on every relaunch.

	     Turning it back on means storing security-scoped bookmarks rather than
	     paths, in SshTunnelConfig and for the certificate directory both. -->
	<!-- Sandbox-only, and inert while the sandbox is off.  Kept so that
	     turning it back on does not silently take the network with it. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Hardened runtime, not sandbox: the dart VM service needs both of
	     these for hot reload. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
